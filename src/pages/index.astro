---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ronak Jethwa">
  <main>
    <header class="masthead">
      <span class="masthead-name">Ronak Jethwa</span>
      <span class="masthead-place">San Francisco</span>
    </header>

    <p class="home-lede">
      Naturally <em>curious</em>, naturally <em>restless</em> — I gravitate toward
      wherever products are made, and I'm still chasing the idea of building
      something the whole world uses.
    </p>

    <nav class="doorways" aria-label="Pages">
      <a class="doorway" href="/work">
        <span class="doorway-name">Work</span>
        <span class="doorway-desc">how I think about building</span>
      </a>
      <a class="doorway" href="/journal">
        <span class="doorway-name">Journal</span>
        <span class="doorway-desc">unfiltered — notes and the odd essay</span>
      </a>
      <a class="doorway" href="/about">
        <span class="doorway-name">About</span>
        <span class="doorway-desc">the person behind the work</span>
      </a>
    </nav>

  </main>
</Layout>
